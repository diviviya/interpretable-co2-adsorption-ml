# Copy to backend/.env for local development. Never commit the real .env file.
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_HOURS=24
ADMIN_USERNAME=projectadmin
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: persistent runtime directory. On Render, mount a disk at /var/data and set this to /var/data.
CO2_DATA_DIR=
# Optional comma-separated origins only if the frontend is hosted on a different domain.
CORS_ALLOWED_ORIGINS=
