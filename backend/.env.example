# Copy to backend/.env for local development. Never commit the real .env file.
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Authentication
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Initial admin account. Created only if this username does not already exist.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Leave blank for local backend/storage. Set to /var/data on Render.
CO2_DATA_DIR=

# Leave blank when FastAPI serves the frontend from the same origin.
CORS_ALLOWED_ORIGINS=
